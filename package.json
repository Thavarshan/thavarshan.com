{
  "name": "@jerome/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node --import tsx automation/ci/build-metadata.ts",
    "start": "tsx automation/static-server.ts out",
    "lint": "eslint .",
    "format": "prettier --write \"{src,automation,workers,tests}/**/*.{ts,tsx}\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"{src,automation,workers,tests}/**/*.{ts,tsx}\" \"*.{ts,mjs}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=moderate",
    "profile:import": "tsx automation/profile/import.ts",
    "profile:github": "tsx automation/profile/github.ts",
    "profile:sync": "tsx automation/profile/sync.ts",
    "profile:publish": "tsx automation/profile/publish.ts",
    "insights:bundle": "tsx automation/marketing/distribution.ts",
    "marketing:oss": "tsx automation/marketing/oss-bundles.ts",
    "growth:metrics": "tsx automation/growth/metrics-snapshot.ts",
    "structure:routes": "tsx automation/structure/routes.ts",
    "registry:sync": "tsx automation/marketing/registry.ts",
    "seo:indexnow": "tsx automation/marketing/indexnow.ts",
    "cv:render": "tsx automation/cv/render.ts",
    "cv:build": "tsx automation/cv/build.ts",
    "cv:publish": "tsx automation/cv/publish.ts",
    "cv:verify": "tsx automation/cv/verify.ts",
    "jobs:collect": "tsx automation/jobs/collect.ts",
    "jobs:validate": "tsx automation/jobs/validate.ts",
    "applications:generate": "tsx automation/applications/generate.ts",
    "applications:review": "tsx automation/applications/review.ts",
    "worker:dev": "wrangler dev --config workers/job-review/wrangler.toml",
    "worker:deploy": "wrangler deploy --config workers/job-review/wrangler.toml",
    "seo:audit": "playwright test --config playwright.seo.config.ts",
    "deployment:smoke": "node --import tsx automation/ci/deployment-smoke.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "csv-parse": "^7.0.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.27.0",
    "next": "^16.4.0",
    "openai": "^7.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.8",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^27.0.0",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.144.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "browserslist": "^4.28.9",
    "esbuild": "^0.28.1",
    "flatted": "^3.4.2",
    "picomatch": "^4.0.3",
    "postcss": "^8.5.28",
    "rollup": "^4.62.3",
    "sharp": "^0.35.5",
    "vite": "^8.1.5",
    "source-map-js": "^1.2.2",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    }
  }
}
